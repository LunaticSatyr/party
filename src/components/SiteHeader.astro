---
import type { HTMLAttributes } from "astro/types";
import { withBase } from "../utils/paths";

interface Props extends HTMLAttributes<"header"> {}

const submenuItems = [
  { label: "About Partistaff", href: "/about" },
  { label: "How it works", href: "/how-it-works" },
  { label: "Pricing", href: "/contact-us" },
  { label: "Talent", href: "/staff" },
  { label: "Clients", href: "/#testimonials" },
  { label: "FAQs", href: "/faqs" },
];

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const isCurrentItem = (href: string) => {
  if (href.startsWith("/#")) return false;
  const targetPath = normalizePath(new URL(withBase(href), Astro.url).pathname);
  return currentPath === targetPath || (targetPath !== "/" && currentPath.startsWith(`${targetPath}/`));
};
const dropdownIsCurrent = submenuItems.some((item) => isCurrentItem(item.href));
const { class: className, ...rest } = Astro.props;
---

<header {...rest} class:list={["site-header", className]} data-site-header>
  <div class="site-header__inner">
    <nav class="site-header__nav" id="primary-navigation" aria-label="Primary navigation" data-primary-nav>
      <ul class="site-header__links">
        <li class="site-header__dropdown" data-nav-dropdown>
          <button
            class:list={["site-header__nav-link", "site-header__nav-parent", { "is-current": dropdownIsCurrent }]}
            type="button"
            aria-expanded="false"
            data-submenu-button
          >
            About Partistaff
            <svg viewBox="0 0 12 12" aria-hidden="true">
              <path d="m2.5 4.5 3.5 3 3.5-3"></path>
            </svg>
          </button>
          <div class="site-header__submenu">
            {
              submenuItems.map((item) => (
                <a
                  class:list={{ "is-current": isCurrentItem(item.href) }}
                  href={withBase(item.href)}
                  aria-current={isCurrentItem(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </li>
        <li>
          <a
            class:list={["site-header__nav-link", { "is-current": isCurrentItem("/staff") }]}
            href={withBase("/staff")}
            aria-current={isCurrentItem("/staff") ? "page" : undefined}
          >Talent</a>
        </li>
        <li><a class="site-header__nav-link" href={withBase("/#services")}>Villas</a></li>
        <li><a class="site-header__nav-link" href={withBase("/contact-us")}>Contact</a></li>
        <li class="site-header__mobile-login">
          <a class="site-header__nav-link" href={withBase("/contact-us")}>Login</a>
        </li>
      </ul>
    </nav>

    <a class="site-header__logo" href={withBase("/")} aria-label="PartiStaff home">
      <img src={withBase("/brand/header-logo.svg")} width="166" height="55" alt="PartiStaff" />
    </a>

    <div class="site-header__actions">
      <a class="site-header__login" href={withBase("/contact-us")}>Login</a>
      <a class="button button--primary site-header__cta" href={withBase("/contact-us")}>Get Started</a>
      <button
        class="site-header__menu-button"
        type="button"
        aria-label="Open navigation"
        aria-controls="primary-navigation"
        aria-expanded="false"
        data-menu-button
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>("[data-site-header]").forEach((header) => {
    const menuButton = header.querySelector<HTMLButtonElement>("[data-menu-button]");
    const navigation = header.querySelector<HTMLElement>("[data-primary-nav]");
    const submenuButton = header.querySelector<HTMLButtonElement>("[data-submenu-button]");
    const dropdown = header.querySelector<HTMLElement>("[data-nav-dropdown]");
    const mobileQuery = window.matchMedia("(max-width: 900px)");

    function setMenu(open: boolean) {
      header.classList.toggle("is-open", open);
      menuButton?.setAttribute("aria-expanded", String(open));
      menuButton?.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      navigation?.setAttribute("aria-hidden", String(!open && mobileQuery.matches));
      document.documentElement.classList.toggle("menu-open", open);
    }

    menuButton?.addEventListener("click", () => {
      setMenu(!header.classList.contains("is-open"));
    });

    submenuButton?.addEventListener("click", () => {
      if (!mobileQuery.matches || !dropdown) return;

      const open = !dropdown.classList.contains("is-submenu-open");
      dropdown.classList.toggle("is-submenu-open", open);
      submenuButton.setAttribute("aria-expanded", String(open));
    });

    navigation?.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setMenu(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenu(false);
    });

    mobileQuery.addEventListener("change", () => {
      setMenu(false);
      dropdown?.classList.remove("is-submenu-open");
      submenuButton?.setAttribute("aria-expanded", "false");
      navigation?.removeAttribute("aria-hidden");
    });

    if (mobileQuery.matches) navigation?.setAttribute("aria-hidden", "true");
  });
</script>

<style>
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100%, var(--container-width));
    height: 5.625rem;
    margin-inline: auto;
    padding-inline: var(--space-page-inline);
    gap: 1.875rem;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-header__links li {
    position: relative;
  }

  .site-header__nav-link,
  .site-header__login {
    color: #000000;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .site-header__nav-link:hover,
  .site-header__login:hover,
  .site-header__nav-link.is-current {
    color: var(--color-accent);
  }

  .site-header__nav-parent {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .site-header__nav-parent svg {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
    transition: transform 160ms ease;
  }

  .site-header__submenu {
    position: absolute;
    top: calc(100% + 1rem);
    left: 0;
    display: flex;
    min-width: 13rem;
    padding: 0.625rem;
    flex-direction: column;
    gap: 0.2rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 0.875rem 2.125rem rgb(0 0 0 / 12%);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-1rem);
    visibility: hidden;
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms ease;
  }

  .site-header__submenu::before {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: 1rem;
    content: "";
  }

  .site-header__submenu a {
    padding: 0.55rem 0.75rem;
    color: #111111;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
  }

  .site-header__submenu a:hover {
    background: #fdeef2;
  }

  .site-header__submenu a.is-current {
    color: var(--color-accent);
    background: #fdeef2;
    font-weight: 700;
  }

  .site-header__dropdown:hover .site-header__submenu,
  .site-header__dropdown:focus-within .site-header__submenu {
    opacity: 1;
    pointer-events: auto;
    transform: none;
    visibility: visible;
  }

  .site-header__dropdown:hover .site-header__nav-parent svg,
  .site-header__dropdown:focus-within .site-header__nav-parent svg {
    transform: rotate(180deg);
  }

  .site-header__logo {
    display: block;
  }

  .site-header__logo img {
    width: 10.375rem;
    height: auto;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
  }

  .site-header__cta {
    min-height: 2.5rem;
    padding-inline: 1.4rem;
  }

  .site-header__menu-button,
  .site-header__mobile-login {
    display: none;
  }

  .site-header__menu-button {
    position: relative;
    width: 1.875rem;
    height: 1.625rem;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .site-header__menu-button span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 0.2rem;
    background: #000000;
    border-radius: 999px;
    transition:
      top 180ms ease,
      transform 180ms ease,
      opacity 180ms ease;
  }

  .site-header__menu-button span:nth-child(1) {
    top: 0.1rem;
  }
  .site-header__menu-button span:nth-child(2) {
    top: 0.7rem;
  }
  .site-header__menu-button span:nth-child(3) {
    top: 1.3rem;
  }

  @media (max-width: 1100px) {
    .site-header__links {
      gap: 1.1rem;
    }
  }

  @media (max-width: 900px) {
    .site-header__inner {
      display: flex;
      height: 5rem;
      justify-content: space-between;
    }

    .site-header__nav {
      position: fixed;
      top: 5rem;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: -1;
      padding: 2rem var(--space-page-inline);
      overflow-y: auto;
      background: #ffffff;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-1rem);
      visibility: hidden;
      transition:
        opacity 220ms ease,
        transform 220ms ease,
        visibility 220ms ease;
    }

    .site-header.is-open .site-header__nav {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
      visibility: visible;
    }

    .site-header__links {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
    }

    .site-header__links > li {
      border-bottom: 1px solid var(--color-border);
    }

    .site-header__nav-link {
      display: flex;
      width: 100%;
      padding-block: 0.9rem;
      justify-content: space-between;
      font-size: 1.125rem;
    }

    .site-header__submenu {
      position: static;
      display: none;
      min-width: 0;
      padding: 0 0 0.75rem 1rem;
      background: transparent;
      border: 0;
      border-left: 1px solid var(--color-border);
      border-radius: 0;
      box-shadow: none;
      opacity: 1;
      transform: none;
      visibility: visible;
    }

    .site-header__dropdown:hover .site-header__submenu,
    .site-header__dropdown:focus-within .site-header__submenu {
      display: none;
      transform: none;
    }

    .site-header__dropdown.is-submenu-open .site-header__submenu,
    .site-header__dropdown.is-submenu-open:hover .site-header__submenu,
    .site-header__dropdown.is-submenu-open:focus-within .site-header__submenu {
      display: flex;
    }

    .site-header__dropdown.is-submenu-open .site-header__nav-parent svg {
      transform: rotate(180deg);
    }

    .site-header__mobile-login,
    .site-header__menu-button {
      display: block;
    }

    .site-header__login {
      display: none;
    }

    .site-header__logo img {
      width: 8.9rem;
    }

    .site-header.is-open .site-header__menu-button span:nth-child(1) {
      top: 0.7rem;
      transform: rotate(45deg);
    }

    .site-header.is-open .site-header__menu-button span:nth-child(2) {
      opacity: 0;
    }

    .site-header.is-open .site-header__menu-button span:nth-child(3) {
      top: 0.7rem;
      transform: rotate(-45deg);
    }
  }

  @media (max-width: 520px) {
    .site-header__inner {
      gap: 0.75rem;
    }

    .site-header__logo img {
      width: 6.6rem;
    }

    .site-header__actions {
      gap: 0.8rem;
    }

    .site-header__cta {
      min-height: 2.25rem;
      padding-inline: 0.9rem;
      font-size: 0.8125rem;
    }

    .site-header__menu-button {
      width: 1.6rem;
    }
  }
</style>
