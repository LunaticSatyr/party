---
import { withBase } from "../../utils/paths";
import type { StaffProfile } from "./staff.types";

interface Props {
  profile: StaffProfile;
  initiallyHidden?: boolean;
}

const { profile, initiallyHidden = false } = Astro.props;
const profileHref = withBase(`/staff/${profile.slug}`);
---

<article
  class="staff-card"
  data-staff-card
  data-name={profile.displayName.toLocaleLowerCase()}
  data-bio={profile.shortBio.toLocaleLowerCase()}
  data-location={profile.location.toLocaleLowerCase()}
  data-roles={profile.roles.join("|").toLocaleLowerCase()}
  data-available={String(profile.isAvailable)}
  data-rating={profile.averageRating}
  data-jobs={profile.totalJobsWorked}
  data-joined={profile.joinedAt}
  hidden={initiallyHidden}
>
  <a class="staff-card__media" href={profileHref} aria-label={`View ${profile.displayName}'s profile`}>
    <img src={withBase(profile.avatar)} alt={profile.displayName} loading="lazy" />
    <span class:list={["staff-card__availability", { "is-unavailable": !profile.isAvailable }]}>
      <span aria-hidden="true"></span>
      {profile.isAvailable ? "Available" : "Unavailable"}
    </span>
  </a>

  <div class="staff-card__body">
    <div class="staff-card__heading">
      <div>
        <h2><a href={profileHref}>{profile.displayName}</a></h2>
        <p>{profile.age ? `${profile.age}, ` : ""}{profile.location}</p>
      </div>
      <span class="staff-card__rating" aria-label={`${profile.averageRating} out of 5 from ${profile.reviewCount} reviews`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 1.8 2.5 5.1 5.7.8-4.1 4 .9 5.6-5-2.6-5 2.6.9-5.6-4.1-4 5.7-.8L10 1.8Z"></path></svg>
        {profile.averageRating.toFixed(1)}
      </span>
    </div>

    <p class="staff-card__roles">{profile.roles.join(" / ")}</p>
    <p class="staff-card__bio">{profile.shortBio}</p>

    <div class="staff-card__footer">
      <span>{profile.totalJobsWorked} jobs</span>
      <a href={profileHref} aria-label={`View ${profile.displayName}'s full profile`}>
        View profile
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5 5 5-5 5M3 10h14"></path></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .staff-card {
    display: grid;
    min-width: 0;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .staff-card[hidden] {
    display: none;
  }

  .staff-card:hover {
    border-color: #c9ccd1;
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 9%);
    transform: translateY(-2px);
  }

  .staff-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e9eaec;
  }

  .staff-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .staff-card:hover .staff-card__media img {
    transform: scale(1.025);
  }

  .staff-card__availability {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    display: inline-flex;
    min-height: 1.875rem;
    padding-inline: 0.7rem;
    align-items: center;
    gap: 0.4rem;
    color: #162119;
    font-size: 0.72rem;
    font-weight: 700;
    background: rgb(255 255 255 / 92%);
    border-radius: 999px;
    backdrop-filter: blur(8px);
  }

  .staff-card__availability span {
    width: 0.45rem;
    height: 0.45rem;
    background: #2aa765;
    border-radius: 50%;
  }

  .staff-card__availability.is-unavailable {
    color: #5d6067;
  }

  .staff-card__availability.is-unavailable span {
    background: #9a9da3;
  }

  .staff-card__body {
    display: flex;
    min-width: 0;
    padding: 1.1rem;
    flex-direction: column;
  }

  .staff-card__heading {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .staff-card__heading > div {
    min-width: 0;
  }

  h2 {
    overflow-wrap: anywhere;
    font-family: var(--font-cursive);
    font-size: 2.15rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }

  h2 a {
    color: var(--color-text);
  }

  .staff-card__heading p {
    margin-top: 0.3rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .staff-card__rating {
    display: inline-flex;
    padding-top: 0.15rem;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .staff-card__rating svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: var(--color-accent);
  }

  .staff-card__roles {
    margin-top: 0.85rem;
    color: var(--color-accent-dark);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .staff-card__bio {
    display: -webkit-box;
    margin-top: 0.65rem;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.84rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .staff-card__footer {
    display: flex;
    padding-top: 1rem;
    margin-top: auto;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .staff-card__footer > span {
    color: var(--color-text-soft);
    font-size: 0.75rem;
  }

  .staff-card__footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .staff-card__footer a:hover,
  h2 a:hover {
    color: var(--color-accent);
  }

  .staff-card__footer svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .staff-card.is-list {
    grid-template-columns: minmax(11rem, 14rem) minmax(0, 1fr);
  }

  .staff-card.is-list .staff-card__media {
    height: 100%;
    aspect-ratio: 1;
  }

  .staff-card.is-list .staff-card__bio {
    -webkit-line-clamp: 3;
  }

  @media (max-width: 560px) {
    .staff-card.is-list {
      grid-template-columns: 7.5rem minmax(0, 1fr);
    }

    .staff-card.is-list .staff-card__availability {
      display: none;
    }

    .staff-card.is-list .staff-card__body {
      padding: 0.9rem;
    }

    .staff-card.is-list .staff-card__bio {
      display: none;
    }
  }
</style>
