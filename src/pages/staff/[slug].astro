---
import BrandMarquee from "../../components/BrandMarquee.astro";
import { staffRepository } from "../../features/staff/staff.repository";
import type { StaffProfile } from "../../features/staff/staff.types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../utils/paths";

export async function getStaticPaths() {
  const { data } = await staffRepository.list({ limit: 50 });
  return data.map((profile) => ({ params: { slug: profile.slug }, props: { profile } }));
}

interface Props {
  profile: StaffProfile;
}

const { profile } = Astro.props;
const sortedPhotos = [...profile.photos].sort((left, right) => left.order - right.order);
const photoCount = sortedPhotos.length;
const reviewDate = new Intl.DateTimeFormat("en-AU", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout
  title={`${profile.displayName} | PartiStaff Talent`}
  description={profile.shortBio}
>
  <main class="profile">
    <section class="profile__main">
      <div class="container">
        <a class="profile__back" href={withBase("/staff")}>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5-5 5 5 5M3 10h14"></path></svg>
          Back to talent
        </a>

        <div class="profile__layout">
          <div class="profile__media">
            <div class="gallery" data-gallery>
              <div class="gallery__frame">
                <div
                  class:list={["gallery__stage", "scroll-container", { "gallery__stage--single": photoCount === 1 }]}
                  data-stage
                  tabindex="0"
                  role="region"
                  aria-roledescription="carousel"
                  aria-label={`Photos of ${profile.displayName}`}
                >
                  {sortedPhotos.map((photo, index) => (
                    <a
                      id={`photo-${index + 1}`}
                      class="gallery__slide"
                      data-slide
                      href={withBase(photo.url)}
                      target="_blank"
                      rel="noopener"
                      aria-label={`View photo ${index + 1} of ${photoCount} full size`}
                    >
                      <img
                        src={withBase(photo.url)}
                        alt={`${profile.displayName} — photo ${index + 1} of ${photoCount}`}
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : undefined}
                        decoding="async"
                        draggable="false"
                      />
                    </a>
                  ))}
                </div>

                {photoCount > 1 && (
                  <>
                    <button class="gallery__arrow gallery__arrow--prev" type="button" data-prev aria-label="Previous photo">
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5-5 5 5 5"></path></svg>
                    </button>
                    <button class="gallery__arrow gallery__arrow--next" type="button" data-next aria-label="Next photo">
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5"></path></svg>
                    </button>
                    <button class="gallery__counter" type="button" data-open-lightbox aria-label={`View all ${photoCount} photos`}>
                      <span data-counter>1 / {photoCount}</span>
                      <span class="gallery__counter-more">&ensp;·&ensp;View all</span>
                    </button>
                  </>
                )}
              </div>

              {photoCount > 1 && (
                <div class="gallery__rail scroll-container" data-rail>
                  {sortedPhotos.map((photo, index) => (
                    <a
                      class="gallery__thumb"
                      href={`#photo-${index + 1}`}
                      data-thumb
                      aria-label={`Go to photo ${index + 1} of ${photoCount}`}
                    >
                      <img src={withBase(photo.url)} alt="" loading="lazy" decoding="async" />
                    </a>
                  ))}
                </div>
              )}

              {photoCount > 1 && (
                <p class="sr-only" aria-live="polite" aria-atomic="true" data-gallery-status>Photo 1 of {photoCount}</p>
              )}
            </div>

            <dialog class="lightbox" data-lightbox aria-label={`${profile.displayName} — photo viewer`}>
              <div class="lightbox__body" data-lightbox-body>
                <div class="lightbox__bar">
                  <span class="lightbox__counter" data-lightbox-counter aria-live="polite" aria-atomic="true">1 / {photoCount}</span>
                  <button class="lightbox__btn" type="button" data-lightbox-close aria-label="Close photo viewer">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"></path></svg>
                  </button>
                </div>
                <img class="lightbox__img" data-lightbox-img alt="" />
                {photoCount > 1 && (
                  <div class="lightbox__nav-row">
                    <button class="lightbox__btn lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous photo">
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5-5 5 5 5"></path></svg>
                    </button>
                    <button class="lightbox__btn lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next photo">
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5"></path></svg>
                    </button>
                  </div>
                )}
              </div>
            </dialog>
          </div>

          <article class="profile__content">
            <div class="profile__status">
              <span class:list={{ "is-unavailable": !profile.isAvailable }} aria-hidden="true"></span>
              {profile.isAvailable ? "Available for bookings" : "Currently unavailable"}
            </div>
            <h1>{profile.displayName}</h1>
            <p class="profile__location">{profile.age ? `${profile.age}, ` : ""}{profile.location} / {profile.countryCode}</p>

            <div class="profile__roles">
              {profile.roles.map((role) => <span>{role}</span>)}
            </div>

            <dl class="profile__stats">
              <div><dt>Rating</dt><dd>{profile.averageRating.toFixed(1)} / 5</dd></div>
              <div><dt>Reviews</dt><dd>{profile.reviewCount}</dd></div>
              <div><dt>Jobs worked</dt><dd>{profile.totalJobsWorked}</dd></div>
            </dl>

            <p class="profile__bio">{profile.longBio}</p>

            <div class="profile__languages">
              <h2>Languages</h2>
              <p>{profile.languages.join(", ")}</p>
            </div>

            <a class="button button--primary" href={withBase("/contact-us")}>Ask about availability</a>
          </article>
        </div>
      </div>
    </section>

    <section class="profile__reviews">
      <div class="container">
        <header>
          <p>Client feedback</p>
          <h2>Recent Reviews</h2>
        </header>
        <div class="profile__review-grid">
          {profile.reviews.map((review) => (
            <article>
              <div class="profile__review-rating" role="img" aria-label={`${review.rating} out of 5 stars`}>
                {Array.from({ length: review.rating }, () => <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 1.8 2.5 5.1 5.7.8-4.1 4 .9 5.6-5-2.6-5 2.6.9-5.6-4.1-4 5.7-.8L10 1.8Z"></path></svg>)}
              </div>
              <blockquote>{review.comment}</blockquote>
              <footer><strong>{review.reviewerName}</strong><span>{reviewDate.format(new Date(review.createdAt))}</span></footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <BrandMarquee />

    <div class="profile__cta-bar">
      <div class="profile__cta-meta">
        <strong>{profile.displayName}</strong>
        <span>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 1.8 2.5 5.1 5.7.8-4.1 4 .9 5.6-5-2.6-5 2.6.9-5.6-4.1-4 5.7-.8L10 1.8Z"></path></svg>
          {profile.averageRating.toFixed(1)} · {profile.reviewCount} reviews
        </span>
      </div>
      <a class="button button--primary" href={withBase("/contact-us")}>Ask about availability</a>
    </div>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    const stageEl = root.querySelector<HTMLElement>("[data-stage]");
    const slides = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-slide]"));
    const count = slides.length;

    if (!stageEl || count === 0) {
      return;
    }

    const stage = stageEl;
    const thumbs = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-thumb]"));
    const prevButton = root.querySelector<HTMLButtonElement>("[data-prev]");
    const nextButton = root.querySelector<HTMLButtonElement>("[data-next]");
    const counter = root.querySelector<HTMLElement>("[data-counter]");
    const status = root.querySelector<HTMLElement>("[data-gallery-status]");
    const openButton = root.querySelector<HTMLButtonElement>("[data-open-lightbox]");
    const rail = root.querySelector<HTMLElement>("[data-rail]");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let index = 0;
    let target = 0;

    root.classList.add("is-enhanced");

    function scrollBehavior(): ScrollBehavior {
      return prefersReducedMotion.matches ? "auto" : "smooth";
    }

    function setCurrent(next: number) {
      index = next;
      target = next;

      if (counter) {
        counter.textContent = `${next + 1} / ${count}`;
      }

      if (status) {
        status.textContent = `Photo ${next + 1} of ${count}`;
      }

      thumbs.forEach((thumb, thumbIndex) => {
        if (thumbIndex === next) {
          thumb.setAttribute("aria-current", "true");
        } else {
          thumb.removeAttribute("aria-current");
        }
      });

      const thumb = thumbs[next];

      if (rail && thumb) {
        const thumbRect = thumb.getBoundingClientRect();
        const railRect = rail.getBoundingClientRect();

        if (thumbRect.left < railRect.left) {
          rail.scrollBy({ left: thumbRect.left - railRect.left, behavior: scrollBehavior() });
        } else if (thumbRect.right > railRect.right) {
          rail.scrollBy({ left: thumbRect.right - railRect.right, behavior: scrollBehavior() });
        }
      }
    }

    function goTo(photoIndex: number, behavior: ScrollBehavior = scrollBehavior()) {
      const wrapped = ((photoIndex % count) + count) % count;
      const scrollPadding = parseFloat(getComputedStyle(stage).scrollPaddingInlineStart) || 0;
      const delta = slides[wrapped].getBoundingClientRect().left - stage.getBoundingClientRect().left - scrollPadding;
      stage.scrollBy({ left: delta, behavior });
    }

    if (count > 1) {
      const visibility = new Map<Element, number>();
      let frame = 0;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            visibility.set(entry.target, entry.isIntersecting ? entry.intersectionRatio : 0);
          });

          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            let best = index;
            let bestRatio = 0;

            slides.forEach((slide, slideIndex) => {
              const ratio = visibility.get(slide) ?? 0;

              if (ratio > bestRatio) {
                bestRatio = ratio;
                best = slideIndex;
              }
            });

            if (stage.scrollLeft <= 1) {
              best = 0;
            } else if (stage.scrollLeft + stage.clientWidth >= stage.scrollWidth - 1) {
              best = count - 1;
            }

            if (best !== index) {
              setCurrent(best);
            }
          });
        },
        { root: stage, threshold: [0.55, 0.95] },
      );

      slides.forEach((slide) => observer.observe(slide));

      function navigate(next: number) {
        target = ((next % count) + count) % count;
        goTo(target);
      }

      prevButton?.addEventListener("click", () => navigate(target - 1));
      nextButton?.addEventListener("click", () => navigate(target + 1));

      thumbs.forEach((thumb, thumbIndex) => {
        thumb.addEventListener("click", (event) => {
          event.preventDefault();
          navigate(thumbIndex);
        });
      });

      stage.addEventListener("keydown", (event) => {
        const jumps: Record<string, number> = {
          ArrowLeft: target - 1,
          ArrowRight: target + 1,
          Home: 0,
          End: count - 1,
        };

        if (event.key in jumps) {
          event.preventDefault();
          navigate(jumps[event.key]);
        }
      });

      setCurrent(0);
    }

    const lightboxEl = document.querySelector<HTMLDialogElement>("[data-lightbox]");
    const lightboxImageEl = lightboxEl?.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const lightboxCloseEl = lightboxEl?.querySelector<HTMLButtonElement>("[data-lightbox-close]");

    if (!lightboxEl || !lightboxImageEl || !lightboxCloseEl) {
      return;
    }

    const lightbox = lightboxEl;
    const lightboxImage = lightboxImageEl;
    const lightboxClose = lightboxCloseEl;

    const lightboxCounter = lightbox.querySelector<HTMLElement>("[data-lightbox-counter]");
    const lightboxBody = lightbox.querySelector<HTMLElement>("[data-lightbox-body]");
    let lightboxIndex = 0;
    let lastFocused: HTMLElement | null = null;

    const clearFade = () => lightboxImage.classList.remove("is-fading");
    lightboxImage.addEventListener("load", clearFade);
    lightboxImage.addEventListener("error", clearFade);

    function showAt(photoIndex: number) {
      lightboxIndex = ((photoIndex % count) + count) % count;
      const slide = slides[lightboxIndex];

      if (!prefersReducedMotion.matches) {
        lightboxImage.classList.add("is-fading");
      }

      lightboxImage.src = slide.href;
      lightboxImage.alt = slide.querySelector("img")?.alt ?? "";

      if (lightboxImage.complete) {
        clearFade();
      }

      if (lightboxCounter) {
        lightboxCounter.textContent = `${lightboxIndex + 1} / ${count}`;
      }

      if (count > 1) {
        new Image().src = slides[(lightboxIndex + 1) % count].href;
        new Image().src = slides[(lightboxIndex - 1 + count) % count].href;
      }
    }

    function openLightbox(at: number) {
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      showAt(at);
      lightbox.showModal();
      document.documentElement.classList.add("has-lightbox");
      lightboxClose.focus();
    }

    slides.forEach((slide, slideIndex) => {
      slide.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
          return;
        }

        event.preventDefault();
        openLightbox(slideIndex);
      });
    });

    openButton?.addEventListener("click", () => openLightbox(index));
    lightbox.querySelector<HTMLButtonElement>("[data-lightbox-prev]")?.addEventListener("click", () => showAt(lightboxIndex - 1));
    lightbox.querySelector<HTMLButtonElement>("[data-lightbox-next]")?.addEventListener("click", () => showAt(lightboxIndex + 1));
    lightboxClose.addEventListener("click", () => lightbox.close());

    lightbox.addEventListener("keydown", (event) => {
      if (count === 1) {
        return;
      }

      const jumps: Record<string, number> = {
        ArrowLeft: lightboxIndex - 1,
        ArrowRight: lightboxIndex + 1,
        Home: 0,
        End: count - 1,
      };

      if (event.key in jumps) {
        event.preventDefault();
        showAt(jumps[event.key]);
      }
    });

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox || event.target === lightboxBody) {
        lightbox.close();
      }
    });

    lightbox.addEventListener("close", () => {
      document.documentElement.classList.remove("has-lightbox");

      if (count > 1) {
        setCurrent(lightboxIndex);
      }

      const restoreTarget =
        lastFocused && slides.includes(lastFocused as HTMLAnchorElement) ? slides[lightboxIndex] : lastFocused;
      restoreTarget?.focus({ preventScroll: true });
      goTo(lightboxIndex, "auto");
    });
  });
</script>

<style>
  .profile__main {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    background: #ffffff;
  }

  .profile__back {
    display: inline-flex;
    margin-bottom: 1.5rem;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .profile__back:hover {
    color: var(--color-accent);
  }

  .profile__back svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .profile__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(22rem, 0.9fr);
    align-items: start;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .profile__media {
    min-width: 0;
  }

  .gallery__frame {
    position: relative;
  }

  .gallery__stage {
    display: flex;
    height: clamp(26rem, 62vh, 38rem);
    overflow-x: auto;
    gap: 0.75rem;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
  }

  .gallery__stage:focus-visible {
    border-radius: var(--radius-md);
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .gallery__stage--single {
    justify-content: center;
  }

  .gallery__slide {
    flex: 0 0 auto;
    height: 100%;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #e9eaec;
    border-radius: var(--radius-md);
    cursor: zoom-in;
    scroll-snap-align: start;
  }

  .gallery__slide:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
  }

  .gallery__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    transition: transform 400ms ease;
    user-select: none;
  }

  .gallery__slide:hover img,
  .gallery__slide:focus-visible img {
    transform: scale(1.025);
  }

  .gallery__arrow {
    position: absolute;
    top: 50%;
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    background: rgb(255 255 255 / 92%);
    border: 0;
    border-radius: 999px;
    backdrop-filter: blur(8px);
    cursor: pointer;
    opacity: 0;
    transition: opacity 180ms ease;
    translate: 0 -50%;
  }

  .gallery.is-enhanced .gallery__arrow {
    display: inline-flex;
  }

  .gallery__arrow--prev {
    left: 0.75rem;
  }

  .gallery__arrow--next {
    right: 0.75rem;
  }

  .gallery__frame:hover .gallery__arrow,
  .gallery__frame:focus-within .gallery__arrow {
    opacity: 1;
  }

  .gallery__arrow:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .gallery__arrow svg,
  .lightbox__btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .gallery__counter {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: none;
    min-height: 1.875rem;
    padding-inline: 0.7rem;
    align-items: center;
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 700;
    background: rgb(255 255 255 / 92%);
    border: 0;
    border-radius: 999px;
    backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .gallery.is-enhanced .gallery__counter {
    display: inline-flex;
  }

  .gallery__counter:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .gallery__rail {
    display: flex;
    margin-top: 0.75rem;
    overflow-x: auto;
    gap: 0.5rem;
    scroll-snap-type: x proximity;
  }

  .gallery__thumb {
    flex: 0 0 4.5rem;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    opacity: 0.55;
    transition: opacity 180ms ease;
    scroll-snap-align: start;
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  .gallery__thumb[aria-current="true"] {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    opacity: 1;
  }

  .gallery__thumb:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
    opacity: 1;
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    background: transparent;
    border: 0;
  }

  .lightbox::backdrop {
    background: rgb(10 10 10 / 92%);
  }

  .lightbox__body {
    position: relative;
    display: grid;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: clamp(0.75rem, 3vw, 2rem);
    grid-template-rows: auto 1fr;
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #ffffff;
  }

  .lightbox__counter {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lightbox__img {
    width: auto;
    max-width: min(92vw, 80rem);
    height: auto;
    max-height: 82vh;
    border-radius: var(--radius-sm);
    object-fit: contain;
    place-self: center;
    transition: opacity 180ms ease;
    user-select: none;
  }

  .lightbox__img.is-fading {
    opacity: 0;
  }

  .lightbox__btn {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: rgb(10 10 10 / 55%);
    border: 1px solid rgb(255 255 255 / 40%);
    border-radius: 999px;
    backdrop-filter: blur(4px);
    cursor: pointer;
  }

  .lightbox__btn:hover {
    border-color: #ffffff;
  }

  .lightbox__btn:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .lightbox__nav-row {
    display: contents;
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__nav--prev {
    left: clamp(0.75rem, 2vw, 2rem);
  }

  .lightbox__nav--next {
    right: clamp(0.75rem, 2vw, 2rem);
  }

  :global(html.has-lightbox .app-layout-content) {
    overflow: hidden;
  }

  .profile__content {
    position: sticky;
    top: 2rem;
    padding-top: 1rem;
  }

  .profile__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #276c47;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .profile__status > span {
    width: 0.5rem;
    height: 0.5rem;
    background: #2aa765;
    border-radius: 50%;
  }

  .profile__status > span.is-unavailable {
    background: #9a9da3;
  }

  .profile__status:has(.is-unavailable) {
    color: var(--color-text-muted);
  }

  h1,
  .profile__reviews h2 {
    font-family: var(--font-cursive);
    font-weight: 400;
    letter-spacing: 0;
  }

  h1 {
    margin-top: 0.8rem;
    overflow-wrap: anywhere;
    font-size: clamp(4rem, 6vw, 6rem);
    line-height: 0.95;
  }

  .profile__location {
    margin-top: 0.7rem;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .profile__roles {
    display: flex;
    margin-top: 1.5rem;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .profile__roles span {
    padding: 0.4rem 0.65rem;
    color: var(--color-accent-dark);
    font-size: 0.68rem;
    font-weight: 700;
    background: #fdeef2;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .profile__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-block: 1.5rem;
    margin-top: 1.75rem;
